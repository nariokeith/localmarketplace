NODE_ENV=production
PORT=3000
DATABASE=mongodb+srv://username:<db_password>@cluster.mongodb.net/local-marketplace
DATABASE_PASSWORD=your_database_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
EMAIL_USERNAME=your_mailtrap_or_smtp_username
EMAIL_PASSWORD=your_mailtrap_or_smtp_password
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
FRONTEND_URL=http://localhost:3001
